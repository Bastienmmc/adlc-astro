---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ProjectSection from '../components/ProjectSection.astro';
import { withDrone } from '../data/projects';
---

<Layout title="Drone - Au-dela du cadre" description="Prises de vue aeriennes integrees a des films corporate, reportage et documentaire.">
  <PageHero
    title="Prises de vue aeriennes au service du film."
    text="Le drone n est pas un effet ajoute au projet. Il intervient lorsqu il permet de mieux situer un lieu, de clarifier un espace, d apporter du souffle ou de prolonger un recit."
  />

  <section class="section">
    <div class="container copy-block reveal">
      <p>
        Integrees a un film corporate, un reportage ou une video de valorisation, les images aeriennes
        permettent d ouvrir le regard sans rompre l equilibre du montage. L objectif reste toujours
        le meme : utiliser le bon plan, au bon moment.
      </p>
      <a class="btn btn-primary" href="/contact">Parler d un projet drone</a>
    </div>
  </section>

  <ProjectSection
    id="drone"
    title="Selection drone"
    intro="Projets ou la prise de vue aerienne vient enrichir le recit sans le surcharger."
    projects={withDrone()}
  />
</Layout>
