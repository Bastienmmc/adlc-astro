---
import Layout from '../layouts/Layout.astro';
import HeroFeatured from '../components/HeroFeatured.astro';
import CategoryNav from '../components/CategoryNav.astro';
import { byCategory, featuredProject } from '../data/projects';
import { site } from '../data/site';
---

<Layout
  title="Au-dela du cadre"
  description="Portfolio video freelance: films de marque, portraits, recits et projets culture & sport."
>
  <HeroFeatured project={featuredProject} />

  <section id="a-propos" class="section">
    <div class="container copy-block reveal">
      <h2>Une approche sobre, attentive et ancree dans le reel.</h2>
      <p class="intro-text">
        Videaste freelance, je realise des films pour des entreprises, associations, institutions et
        projets plus documentaires, avec une attention particuliere portee a la qualite d image, a la
        justesse du ton et a la coherence du rendu final.
      </p>
      <p>
        Chaque demande appelle une reponse differente. Certains projets ont besoin d un cadre clair,
        d une parole bien menee et d une structure efficace. D autres demandent davantage de temps,
        d ecoute et de souplesse. Dans tous les cas, l enjeu reste le meme : produire un film solide,
        lisible et fidele a ce qu il doit transmettre.
      </p>
      <p>
        Je travaille avec une approche simple : comprendre le besoin, definir une forme adaptee,
        tourner de maniere legere et soignee, puis construire un montage precis. Le but n est pas
        d en faire trop, mais de trouver la bonne distance et le bon rythme.
      </p>
    </div>
  </section>

  <CategoryNav />

  <HeroFeatured
    id="films-marque"
    title="Films de marque"
    projects={byCategory('corporate')}
    infoImage="https://i.ytimg.com/vi/3QTM7xPS5oE/maxresdefault.jpg"
    infoDescription="Films de marque pensés pour presenter une activite, un savoir-faire ou une equipe avec une narration claire et une image soignee."
  />

  <HeroFeatured
    id="portraits-recits"
    title="Portraits & recits"
    projects={byCategory('interview')}
    infoImage="https://i.ytimg.com/vi/j0vtMMs8mt4/maxresdefault.jpg"
    infoDescription="Portraits et recits centres sur la presence, la parole et le rythme, avec une approche sensible et humaine de chaque sujet."
  />

  <HeroFeatured
    id="culture-sport"
    title="Culture & sport"
    projects={byCategory('reportage')}
    infoImage="https://i.ytimg.com/vi/OtL_iQfxWvU/maxresdefault.jpg"
    infoDescription="Immersions de terrain pour capter l'energie d'un evenement, d'un lieu ou d'une pratique sportive avec un rendu vivant et precis."
  />

  <section id="contact" class="section">
    <div class="container copy-block reveal">
      <h2>Parlons de votre projet.</h2>
      <p>
        Pour un film de marque, un portrait, un recit de terrain ou un projet culture & sport, vous
        pouvez me contacter par email ou via le formulaire ci-dessous.
      </p>
      <p>
        Decrivez simplement votre besoin, le contexte et ce que vous souhaitez produire. Une reponse
        vous sera apportee dans les meilleurs delais.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-panel reveal">
      <p><strong>Email :</strong> <a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p><strong>Ville / zone :</strong> {site.location}</p>
      <form class="form-grid" method="post" action="#">
        <label>
          Nom
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label>
          Email
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label>
          Votre besoin
          <textarea name="message" rows="6" required></textarea>
        </label>
        <button type="submit">Envoyer</button>
      </form>
    </div>
  </section>
</Layout>
