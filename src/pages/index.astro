---
import Layout from '../layouts/Layout.astro';
import HeroFeatured from '../components/HeroFeatured.astro';
import CategoryNav from '../components/CategoryNav.astro';
import { byCategory, featuredProject } from '../data/projects';
import { site } from '../data/site';
---

<Layout
  title="Au-dela du cadre"
  description="Portfolio video freelance: films de marque, portraits, recits et projets culture & sport."
>
  <HeroFeatured project={featuredProject} />

  <section id="a-propos" class="section">
    <div class="container copy-block reveal">
      <h2>Une approche sobre, attentive et ancrée dans le réel.</h2>
      <p class="intro-text">
        Vidéaste freelance, je conçois des films pour des entreprises, des associations, des institutions
        et des projets documentaires. Mon travail cherche la justesse du ton, la cohérence du récit et
        une image au service du propos.
      </p>
      <p><a href="/bio">Lire plus</a></p>
    </div>
  </section>

  <CategoryNav />

  <HeroFeatured
    id="films-marque"
    title="Films de marque"
    projects={byCategory('corporate')}
    infoImage="https://i.ytimg.com/vi/3QTM7xPS5oE/maxresdefault.jpg"
    infoDescription="Des films pensés pour donner une image claire, cohérente et crédible de votre activité. J’y cherche le bon équilibre entre message, rythme et esthétique pour créer un contenu à la fois utile, distinctif et agréable à regarder."
  />

  <HeroFeatured
    id="portraits-recits"
    title="Portraits & recits"
    projects={byCategory('interview')}
    infoImage="https://i.ytimg.com/vi/j0vtMMs8mt4/maxresdefault.jpg"
    infoDescription="Des films plus personnels, centrés sur une personne, un parcours ou une histoire à transmettre. L’approche est plus intime, plus posée, avec une attention particulière portée à la parole, aux gestes et à ce qui rend chaque sujet singulier."
  />

  <HeroFeatured
    id="culture-sport"
    title="Culture & sport"
    projects={byCategory('reportage')}
    infoImage="https://i.ytimg.com/vi/OtL_iQfxWvU/maxresdefault.jpg"
    infoDescription="Des films pour capter l’énergie d’un événement, la tension d’une pratique ou l’atmosphère d’un univers culturel. Le but est de restituer le mouvement, l’intensité et l’ambiance sans perdre la lisibilité du récit."
  />

  <section id="contact" class="section">
    <div class="container copy-block reveal">
      <h2>Parlons de votre projet.</h2>
      <p>
        Pour un film de marque, un portrait, un recit de terrain ou un projet culture & sport, vous
        pouvez me contacter par email ou via le formulaire ci-dessous.
      </p>
      <p>
        Decrivez simplement votre besoin, le contexte et ce que vous souhaitez produire. Une reponse
        vous sera apportee dans les meilleurs delais.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-panel reveal">
      <p><strong>Email :</strong> <a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p><strong>Ville / zone :</strong> {site.location}</p>
      <form class="form-grid" method="post" action="#">
        <label>
          Nom
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label>
          Email
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label>
          Votre besoin
          <textarea name="message" rows="6" required></textarea>
        </label>
        <button type="submit">Envoyer</button>
      </form>
    </div>
  </section>
</Layout>
