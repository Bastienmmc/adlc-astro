---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VideoModal from '../components/VideoModal.astro';
import ShareModal from '../components/ShareModal.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  forceLight?: boolean;
  lightContentOnly?: boolean;
}

const {
  title = 'Au-dela du cadre - Portfolio video',
  description = 'Portfolio video minimaliste d un videaste freelance.',
  forceLight = false,
  lightContentOnly = false,
} = Astro.props;
---

<!doctype html>
<html lang="fr" data-force-light={forceLight ? 'true' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@400;500;600;700&family=Manrope:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-light-content={lightContentOnly ? 'true' : undefined}>
    <Header />
    <main class={lightContentOnly ? 'content-surface-light' : undefined}>
      <slot />
    </main>
    <Footer />
    <VideoModal />
    <ShareModal />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const body = document.body;
        const forceLightTheme = root.getAttribute('data-force-light') === 'true';
        const hasLightContentOnly = body?.getAttribute('data-light-content') === 'true';
        let theme = hasLightContentOnly
          ? 'dark'
          : forceLightTheme
          ? 'light'
          : localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        root.setAttribute('data-theme', theme);

        const toggle = document.querySelector('[data-theme-toggle]');
        if (toggle) {
          toggle.addEventListener('click', () => {
            if (forceLightTheme || hasLightContentOnly) {
              return;
            }

            theme = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', theme);
            localStorage.setItem('theme', theme);
            updateThemeIcon();
          });

          const updateThemeIcon = () => {
            const isDark = root.getAttribute('data-theme') === 'dark';
            toggle.innerHTML = isDark
              ? '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>'
              : '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>';
          };
          updateThemeIcon();
        }
      })();
    </script>
    <script is:inline>
      const getScrollOffset = () => {
        const header = document.querySelector('.site-header');
        return (header instanceof HTMLElement ? header.offsetHeight : 0) + 16;
      };

      const siteHeader = document.querySelector('.site-header');
      const menuToggle = document.querySelector('[data-menu-toggle]');

      const closeMobileMenu = () => {
        if (!(menuToggle instanceof HTMLButtonElement) || !(siteHeader instanceof HTMLElement)) {
          return;
        }

        siteHeader.classList.remove('menu-open');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.setAttribute('aria-label', 'Ouvrir le menu');
        document.body.classList.remove('lock-scroll');
      };

      const openMobileMenu = () => {
        if (!(menuToggle instanceof HTMLButtonElement) || !(siteHeader instanceof HTMLElement)) {
          return;
        }

        siteHeader.classList.add('menu-open');
        menuToggle.setAttribute('aria-expanded', 'true');
        menuToggle.setAttribute('aria-label', 'Fermer le menu');
        document.body.classList.add('lock-scroll');
      };

      if (menuToggle instanceof HTMLButtonElement && siteHeader instanceof HTMLElement) {
        menuToggle.addEventListener('click', () => {
          const isOpen = siteHeader.classList.contains('menu-open');

          if (isOpen) {
            closeMobileMenu();
          } else {
            openMobileMenu();
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            closeMobileMenu();
          }
        });

        window.addEventListener('resize', () => {
          if (window.innerWidth > 980) {
            closeMobileMenu();
          }
        });
      }

      const scrollToHash = (hash, updateHistory) => {
        if (!hash) {
          return;
        }

        const target = document.querySelector(hash);

        if (!(target instanceof HTMLElement)) {
          return;
        }

        const top = target.getBoundingClientRect().top + window.scrollY - getScrollOffset();

        window.scrollTo({ top, behavior: 'smooth' });

        if (updateHistory) {
          window.history.pushState({}, '', hash);
        }
      };

      document.addEventListener('click', (event) => {
        const target = event.target;

        if (!(target instanceof Element)) {
          return;
        }

        const link = target.closest('a[href]');

        if (!(link instanceof HTMLAnchorElement)) {
          return;
        }

        if (link.closest('.header-navs')) {
          closeMobileMenu();
        }

        const url = new URL(link.href, window.location.href);

        if (url.origin !== window.location.origin || url.pathname !== window.location.pathname || !url.hash) {
          return;
        }

        event.preventDefault();
        scrollToHash(url.hash, true);
      });

      window.addEventListener('load', () => {
        if (!window.location.hash) {
          return;
        }

        window.requestAnimationFrame(() => {
          scrollToHash(window.location.hash, false);
        });
      });

      const categoryCards = Array.from(document.querySelectorAll('.category-card'));
      const canAnimateCards =
        categoryCards.length > 0 &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (canAnimateCards) {
        let cardFrameRequested = false;

        const updateCategoryCardsMotion = () => {
          cardFrameRequested = false;
          const viewportCenter = window.innerHeight / 2;

          categoryCards.forEach((node, index) => {
            if (!(node instanceof HTMLElement)) {
              return;
            }

            const rect = node.getBoundingClientRect();
            const cardCenter = rect.top + rect.height / 2;
            const distance = (cardCenter - viewportCenter) / window.innerHeight;
            const direction = index % 2 === 0 ? 1 : -1;
            const offset = Math.max(-14, Math.min(14, distance * 24 * direction));
            node.style.setProperty('--card-scroll-y', `${offset.toFixed(2)}px`);
          });
        };

        const onCardMotionScroll = () => {
          if (cardFrameRequested) {
            return;
          }

          cardFrameRequested = true;
          window.requestAnimationFrame(updateCategoryCardsMotion);
        };

        window.addEventListener('scroll', onCardMotionScroll, { passive: true });
        window.addEventListener('resize', onCardMotionScroll);
        onCardMotionScroll();
      }

      const scrollSyncNodes = Array.from(document.querySelectorAll('[data-scroll-sync]'));
      const canAnimateScrollSync =
        scrollSyncNodes.length > 0 &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (canAnimateScrollSync) {
        let scrollSyncFrameRequested = false;

        const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

        const updateScrollSync = () => {
          scrollSyncFrameRequested = false;
          const viewportHeight = window.innerHeight || 1;

          scrollSyncNodes.forEach((node) => {
            if (!(node instanceof HTMLElement)) {
              return;
            }

            const rect = node.getBoundingClientRect();
            const center = rect.top + rect.height / 2;
            const start = viewportHeight * 1.2;
            const configuredLag = Number.parseFloat(node.dataset.scrollLag || '0');
            const lag = Number.isFinite(configuredLag) ? configuredLag : 0;
            const delayedCenter = center + lag;
            const phase = node.dataset.scrollPhase === 'title' ? 'title' : 'text';
            const end = viewportHeight * (phase === 'title' ? 0.5 : 0.46);
            const progress = clamp((start - delayedCenter) / (start - end), 0, 1);
            const stagedProgress =
              phase === 'title'
                ? clamp(progress * 1.45, 0, 1)
                : clamp((progress - 0.12) / 0.88, 0, 1);
            const eased =
              phase === 'title'
                ? 1 - Math.pow(1 - stagedProgress, 2.2)
                : 1 - Math.pow(1 - stagedProgress, 1.5);
            const configuredDistance = Number.parseFloat(node.dataset.scrollDistance || '110');
            const distance = Number.isFinite(configuredDistance) ? configuredDistance : 110;
            const shift = (1 - eased) * distance;
            const startOpacity = phase === 'title' ? 0.2 : 0.04;
            const opacity = startOpacity + eased * (1 - startOpacity);
            const lastShift = Number.parseFloat(node.dataset.scrollCurrentY || `${shift}`);
            const lastOpacity = Number.parseFloat(node.dataset.scrollCurrentOpacity || `${opacity}`);
            const smoothShift = lastShift + (shift - lastShift) * 0.22;
            const smoothOpacity = lastOpacity + (opacity - lastOpacity) * 0.24;

            node.dataset.scrollCurrentY = smoothShift.toFixed(3);
            node.dataset.scrollCurrentOpacity = smoothOpacity.toFixed(3);
            node.style.setProperty('--scroll-sync-y', `${smoothShift.toFixed(2)}px`);
            node.style.setProperty('--scroll-sync-opacity', smoothOpacity.toFixed(3));
          });
        };

        const onScrollSync = () => {
          if (scrollSyncFrameRequested) {
            return;
          }

          scrollSyncFrameRequested = true;
          window.requestAnimationFrame(updateScrollSync);
        };

        window.addEventListener('scroll', onScrollSync, { passive: true });
        window.addEventListener('resize', onScrollSync);
        onScrollSync();
      }
    </script>
  </body>
</html>
