---
import { mainNav, secondaryNav, site } from '../data/site';

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href.startsWith('/#')) {
    return false;
  }

  return href === '/' ? pathname === '/' : pathname.startsWith(href);
};
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">{site.name}</a>
    <div class="header-navs" id="site-navigation" data-menu-panel>
      <nav class="main-nav" aria-label="Navigation principale">
        {
          mainNav.map((item) => (
            <a href={item.href} class={isActive(item.href) ? 'active' : ''}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <nav class="secondary-nav" aria-label="Navigation secondaire">
        {
          secondaryNav.map((item) => (
            <a href={item.href} class={isActive(item.href) ? 'active' : ''}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
    <button class="theme-toggle" data-theme-toggle aria-label="Basculer le thème">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
    <button
      class="menu-toggle"
      data-menu-toggle
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="site-navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>
