---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<section id="dernieres-realisations" class="hero-featured reveal" style={`--hero-image: url('${project.thumbnail}')`}>
  <div class="hero-overlay">
    <div class="container hero-content">
      <p class="eyebrow">Dernieres realisations</p>
      <h1>{project.title}</h1>
      <p>
        Une realisation recente mise en avant pour ouvrir la visite, avec la meme attention portee au
        rythme, au regard et a la qualite d image sur l ensemble du portfolio.
      </p>
      <div class="hero-actions">
        <button
          class="btn btn-primary"
          data-video-open
          data-video-slug={project.slug}
          data-video-url={project.videoUrl}
          data-video-title={project.title}
        >
          Lire la video
        </button>
        <a class="btn btn-secondary" href="#a-propos">Voir plus bas</a>
      </div>
    </div>
  </div>
</section>
