---
import type { Project } from '../data/projects';
import { categoryLabels, projects } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const toWatchUrl = (url: string) => {
  const match = url.match(/embed\/([^?&/]+)/);
  if (!match?.[1]) {
    return url;
  }

  return `https://www.youtube.com/watch?v=${match[1]}`;
};

const heroVideos = projects.map((item) => ({
  slug: item.slug,
  title: item.title,
  description: item.description,
  year: item.year,
  category: categoryLabels[item.category],
  videoUrl: item.videoUrl,
  watchUrl: toWatchUrl(item.videoUrl),
  thumbnail: item.thumbnail,
}));
---

<section
  id="dernieres-realisations"
  class="hero-featured reveal"
  style={`--hero-image: url('${project.thumbnail}')`}
  data-hero-videos-root
>
  <div class="hero-overlay">
    <div class="container hero-content hero-content-centered">
      <h1 class="hero-category-label">Dernieres realisations</h1>
      <div class="hero-actions">
        <button
          class="play-cta hero-play-cta"
          data-video-open
          data-video-slug={project.slug}
          data-video-url={project.videoUrl}
          data-video-title={project.title}
        >
          <span class="play-ring">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
          </span>
          <span>Lire la video</span>
        </button>
      </div>
      <button class="hero-videos-toggle hero-videos-rect-btn" type="button" data-hero-videos-toggle>
        Toutes les videos
      </button>
    </div>

    <div class="hero-videos-floatbar" data-hero-videos-floatbar>
      <div class="container hero-videos-topbar">
        <label class="hero-videos-search-wrap" data-hero-search-wrap>
          <span class="hero-videos-search-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </span>
          <input
            type="search"
            class="hero-videos-search"
            data-hero-videos-search
            placeholder="Rechercher une video..."
            aria-label="Rechercher une video"
          />
        </label>

        <div class="hero-videos-toolbar">
          <button
            type="button"
            class="hero-videos-tool"
            data-hero-videos-share
            data-share-button
            data-share-video-url={heroVideos[0]?.watchUrl ?? project.videoUrl}
            data-share-title={heroVideos[0]?.title ?? project.title}
            data-share-text={heroVideos[0]?.description ?? project.title}
            data-share-channel-text="Decouvre toutes les videos"
            aria-label="Partager"
            title="Partager"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.7" y1="10.7" x2="15.3" y2="6.9"></line><line x1="8.7" y1="13.3" x2="15.3" y2="17.1"></line></svg>
          </button>
          <button type="button" class="hero-videos-tool" data-hero-videos-info aria-label="Info" title="Info">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
          </button>
          <button type="button" class="hero-videos-tool is-close" data-hero-videos-close aria-label="Fermer" title="Fermer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>

        <button type="button" class="hero-videos-search-close" data-hero-videos-close aria-label="Fermer la recherche" title="Fermer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <div class="container">
        <div class="hero-videos-info" data-hero-videos-info-panel hidden>
          <p>
            Cette section rassemble toutes les videos publiees. Utilise la recherche pour filtrer puis lance
            rapidement la lecture, ou partage la video courante.
          </p>
        </div>
      </div>
    </div>

    <div class="hero-videos-panel" data-hero-videos-panel aria-hidden="true">
      <div class="hero-videos-inner">
        <div class="hero-videos-list" data-hero-videos-list>
          {
            heroVideos.map((item) => (
              <article
                class="hero-videos-item is-visible"
                data-hero-video-item
                data-slug={item.slug}
                data-search={`${item.title} ${item.category} ${item.year}`.toLowerCase()}
              >
                <img src={item.thumbnail} alt={item.title} loading="lazy" />
                <div class="hero-videos-item-overlay">
                  <h3 class="hero-videos-title">{item.title}</h3>
                  <button
                    class="hero-videos-read hero-videos-rect-btn"
                    type="button"
                    data-video-open
                    data-video-slug={item.slug}
                    data-video-url={item.videoUrl}
                    data-video-title={item.title}
                  >
                    <span class="play-ring" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
                    </span>
                    <span>Lire la video</span>
                  </button>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ heroVideos }}>
  const heroRoot = document.querySelector('[data-hero-videos-root]');

  if (heroRoot instanceof HTMLElement) {
    const panel = heroRoot.querySelector('[data-hero-videos-panel]');
    const openButton = heroRoot.querySelector('[data-hero-videos-toggle]');
    const closeButtons = heroRoot.querySelectorAll('[data-hero-videos-close]');
    const infoButton = heroRoot.querySelector('[data-hero-videos-info]');
    const infoPanel = heroRoot.querySelector('[data-hero-videos-info-panel]');
    const searchWrap = heroRoot.querySelector('[data-hero-search-wrap]');
    const searchInput = heroRoot.querySelector('[data-hero-videos-search]');
    const shareButton = heroRoot.querySelector('[data-hero-videos-share]');
    const items = Array.from(heroRoot.querySelectorAll('[data-hero-video-item]'));
    const bySlug = new Map((Array.isArray(heroVideos) ? heroVideos : []).map((item) => [item.slug, item]));

    let activeSlug = (Array.isArray(heroVideos) && heroVideos[0]?.slug) || '';

    const setShareTarget = (slug) => {
      const item = bySlug.get(slug);
      if (!(shareButton instanceof HTMLButtonElement) || !item) {
        return;
      }

      activeSlug = slug;
      shareButton.setAttribute('data-share-video-url', item.watchUrl);
      shareButton.setAttribute('data-share-title', item.title);
      shareButton.setAttribute('data-share-text', item.description);
    };

    const setSearchActive = (nextActive) => {
      heroRoot.classList.toggle('is-search-active', nextActive);

      if (searchWrap instanceof HTMLElement) {
        searchWrap.classList.toggle('is-expanded', nextActive);
      }
    };

    const setPanelOpen = (nextOpen) => {
      if (!(panel instanceof HTMLElement)) {
        return;
      }

      panel.setAttribute('aria-hidden', nextOpen ? 'false' : 'true');
      heroRoot.classList.toggle('is-videos-open', nextOpen);

      if (!nextOpen) {
        setSearchActive(false);
      }
    };

    const updateList = () => {
      const query = searchInput instanceof HTMLInputElement ? searchInput.value.trim().toLowerCase() : '';
      let visibleIndex = 0;
      let firstVisibleSlug = '';

      items.forEach((node) => {
        if (!(node instanceof HTMLElement)) {
          return;
        }

        const searchValue = node.getAttribute('data-search') || '';
        const matches = !query || searchValue.includes(query);
        node.hidden = !matches;
        node.classList.toggle('is-visible', matches);

        if (matches) {
          node.style.setProperty('--hero-item-delay', `${visibleIndex * 45}ms`);
          visibleIndex += 1;
          if (!firstVisibleSlug) {
            firstVisibleSlug = node.getAttribute('data-slug') || '';
          }
        }
      });

      if (firstVisibleSlug) {
        setShareTarget(firstVisibleSlug);
      }
    };

    if (openButton instanceof HTMLButtonElement) {
      openButton.addEventListener('click', () => setPanelOpen(true));
    }

    closeButtons.forEach((button) => {
      if (button instanceof HTMLButtonElement) {
        button.addEventListener('click', () => setPanelOpen(false));
      }
    });

    if (infoButton instanceof HTMLButtonElement && infoPanel instanceof HTMLElement) {
      infoButton.addEventListener('click', () => {
        const shouldShow = infoPanel.hasAttribute('hidden');
        infoPanel.toggleAttribute('hidden', !shouldShow);
        infoButton.classList.toggle('is-active', shouldShow);
      });
    }

    if (searchInput instanceof HTMLInputElement) {
      searchInput.addEventListener('input', updateList);

      searchInput.addEventListener('click', () => {
        setSearchActive(true);
      });
    }

    items.forEach((node) => {
      if (!(node instanceof HTMLElement)) {
        return;
      }

      node.addEventListener('mouseenter', () => {
        const slug = node.getAttribute('data-slug') || '';
        if (slug) {
          setShareTarget(slug);
        }
      });

      node.addEventListener('focusin', () => {
        const slug = node.getAttribute('data-slug') || '';
        if (slug) {
          setShareTarget(slug);
        }
      });

      const readButton = node.querySelector('[data-video-open]');
      if (readButton instanceof HTMLButtonElement) {
        readButton.addEventListener('click', () => {
          const slug = node.getAttribute('data-slug') || '';
          if (slug) {
            setShareTarget(slug);
          }
          setPanelOpen(false);
        });
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && panel instanceof HTMLElement && panel.getAttribute('aria-hidden') === 'false') {
        setPanelOpen(false);
      }
    });

    setShareTarget(activeSlug);
    updateList();
  }
</script>
