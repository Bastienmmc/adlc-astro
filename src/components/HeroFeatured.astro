---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<section id="dernieres-realisations" class="hero-featured reveal" style={`--hero-image: url('${project.thumbnail}')`}>
  <div class="hero-overlay">
    <div class="container hero-content hero-content-centered">
      <h1 class="hero-category-label">Dernieres realisations</h1>
      <div class="hero-actions">
        <button
          class="play-cta hero-play-cta"
          data-video-open
          data-video-slug={project.slug}
          data-video-url={project.videoUrl}
          data-video-title={project.title}
        >
          <span class="play-ring">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
          </span>
          <span>Lire la video</span>
        </button>
      </div>
    </div>
  </div>
</section>
